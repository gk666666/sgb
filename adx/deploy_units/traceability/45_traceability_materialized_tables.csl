    ws1__8pa1__defects_b__unload_pack__status:string,
    ws1__8pa1__packing__time:datetime,
    ws1__8pa1__packing__rack_id:string,
    ws1__8pa1__packing__slot_id:int,
    ws1__8pa1__curing__time:datetime,
    ws1__8pa1__curing__rack_id:string,
    ws1__8pa1__curing__entry_time:datetime,
    ws1__8pa1__curing__curing_time:real,
    ws1__8pa1__curing__is_departed:int,
    ws1__8pa1__curing__departure_time:datetime,
    ws1__8pa1__curing__departure_rfid_write:string,
    ws1__8pa1__curing__write_status:int,
    ws1__8pa1__curing__write_time:datetime
)

