    ws1__8pa1__defects_b__defects__rework_code:string,
    ws1__8pa1__defects_b__marposs__time:datetime,
    ws1__8pa1__defects_b__marposs__status:string,
    ws1__8pa1__defects_b__llp_label__time:datetime,
    ws1__8pa1__defects_b__llp_label__code:string,
