// 追溯物化层脚本。
//
// 这层负责把 25_traceability_normalize_and_wide_logic.csl 中的函数视图正式落成物理对象：
// 1) 追溯标准事件历史表：保留全历史；
// 2) 追溯宽表当前态：保留“一块玻璃一行”的快照；
// 3) Grafana 类查询需要的 Final / Milling 缺陷聚合表。
//
// 注意：
// - traceability_normalized_events_v2 适合用 update policy 自动追加历史；
// - traceability_wide_v2 和两张 defect agg 表属于“当前态/聚合态”，
//   不适合直接靠 update policy 持续 append，通常应走显式刷新。
//
// 对象说明：
// - table traceability_normalized_events_v2：追溯标准事件历史表。
// - function fn_traceability_normalized_events_materialize_v1()：标准事件物化函数。
// - policy traceability_normalized_events_v2 update policy：把 raw 新数据自动落历史表。
// - table traceability_wide_v2：一块玻璃一行的追溯宽表当前态。
// - function fn_traceability_wide_v2_materialize_v1()：宽表快照重算函数。
// - table traceability_final_defect_agg_v1：Final 缺陷聚合表。
// - function fn_traceability_final_defect_agg_materialize_v1()：Final 缺陷聚合函数。
// - table traceability_milling_defect_agg_v1：Milling 缺陷聚合表。
// - function fn_traceability_milling_defect_agg_materialize_v1()：Milling 缺陷聚合函数。
// - function fn_traceability_dashboard_equivalent_v1(...)：面向 Grafana 的查询封装。

// traceability_normalized_events_v2：追溯标准事件历史表，按事件粒度保存全历史。
// raw_traceability_eh 的新消息会通过 update policy 自动清洗后追加到这张表。
.create-merge table traceability_normalized_events_v2 (
    glass_key:string,
    event_time:datetime,
    event_source:string,
    source_topic:string,
    source_message_id:string,
    dmc_code:string,
    rfid:string,
    rfid_prefix28:string,
    aura_code:string,
    pdlc_code:string,
    mest_result:string,
    status:string,
    lig_code:string,
    bracket_rfid_code:string,
    primer_code:string,
    rack_id:string,
    slot_id:int,
    bottle1_code:string,
    bottle2_code:string,
    bottle3_code:string,
    temp:real,
    humidity:real
)

// 标准事件历史层：只保留统一 schema 的事件视角结果，不做宽表聚合。
// fn_traceability_normalized_events_materialize_v1：追溯标准事件历史表的物化函数。
// 它读取 fn_traceability_normalized_events_v1，把统一事件流投影成 traceability_normalized_events_v2 的落表字段。
.create-or-alter function with (folder = "traceability/materialize", docstring = "Normalized traceability events materialized for historical retention") fn_traceability_normalized_events_materialize_v1() {
    fn_traceability_normalized_events_v1()
    | project
        glass_key,
        event_time,
        event_source,
        source_topic,
        source_message_id,
        dmc_code,
        rfid,
        rfid_prefix28,
        aura_code,
        pdlc_code,
        mest_result,
        status,
        lig_code,
        bracket_rfid_code,
        primer_code,
        rack_id,
        slot_id,
        bottle1_code,
        bottle2_code,
        bottle3_code,
        temp,
        humidity
}

// traceability_normalized_events_v2 update policy：把 raw_traceability_eh 新进来的追溯原始消息自动清洗后追加到历史事件表。
// raw_traceability_eh 是源表，fn_traceability_normalized_events_materialize_v1() 是清洗逻辑，traceability_normalized_events_v2 是落地表。
.alter table traceability_normalized_events_v2 policy update @'[{"IsEnabled": true, "Source": "raw_traceability_eh", "Query": "fn_traceability_normalized_events_materialize_v1()", "IsTransactional": false, "PropagateIngestionProperties": true}]'

// traceability_wide_v2：一片玻璃一行的追溯宽表当前态。
// 它不会通过 update policy 持续 append，而是通过显式刷新重算当前快照。
.create-merge table traceability_wide_v2 (
    glass_key:string,
    dmc_code:string,
    rfid:string,
    aura_code:string,
    pdlc_code:string,
    mest_result:string,
    status:string,
    ws1__2cw2__time:datetime,
    ws1__2cw2__rfid:string,
    ws1__3fw2__time:datetime,
    ws1__3fw2__rfid:string,
    ws1__3fw2__mold_number:int,
    ws1__3fw2__mold_type:int,
    ws1__3fw2__mold_temp:int,
    ws1__3fw2__furnace_ch1_temp:int,
    ws1__3fw2__furnace_ch3_temp:int,
    ws1__3fw2__furnace_ch5_temp:int,
    ws1__4aw2__time:datetime,
    ws1__4aw2__rfid:string,
    ws1__5fn6__final__time:datetime,
    ws1__5fn6__final__rfid:string,
    ws3__prim__time:datetime,
    ws3__prim__rfid:string,
    ws3__prim__bottle1_code:string,
    ws3__prim__bottle2_code:string,
    ws3__prim__bottle3_code:string,
    ws3__prim__temp:real,
    ws3__prim__humidity:real,
    ws3__prim__inspec_rfid_write:string,
    ws3__prim_inspec__time:datetime,
    ws3__prim_inspec__rfid:string,
    ws3__curing__time:datetime,
    ws3__curing__rack_id:string,
    ws3__curing__entry_time:datetime,
    ws3__curing__entry_rfid_read:string,
    ws3__curing__curing_time:real,
    ws3__curing__is_departed:int,
    ws3__curing__departure_time:datetime,
    ws3__curing__departure_rfid_write:string,
    ws3__curing__write_status:int,
    ws3__curing__write_time:datetime,
    ws3__pu1__time:datetime,
    ws3__pu1__rfid:string,
    ws3__pu1__temp:real,
    ws3__pu1__humidity:real,
    ws3__pu1__mold_up_zone01:int,
    ws3__pu1__mold_up_zone02:int,
    ws3__pu1__mold_down_zone01:int,
    ws3__pu1__mold_down_zone02:int,
    ws1__8pa1__milling__time:datetime,
    ws1__8pa1__milling__rfid:string,
    ws1__8pa1__milling__manual_upload:int,
    ws1__8pa1__milling__destination:string,
    ws1__8pa1__eolcv__time:datetime,
    ws1__8pa1__eolcv__rfid:string,
    ws1__8pa1__eolcv__mest_pdlc:string,
    ws1__8pa1__eolcv__lig_1:string,
    ws1__8pa1__eolcv__lig_2:string,
    ws1__8pa1__eolcv__result:string,
    ws1__8pa1__eolcv__front_sky_holder__time:datetime,
    ws1__8pa1__eolcv__front_sky_holder__part1_status:string,
    ws1__8pa1__eolcv__front_sky_holder__part2_status:string,
    ws1__8pa1__eolcv__front_sky_holder__part3_status:string,
    ws1__8pa1__eolcv__front_sky_holder__push2_status:string,
    ws1__8pa1__eolcv__ecu__time:datetime,
    ws1__8pa1__eolcv__ecu__a02prussure_status:string,
    ws1__8pa1__eolcv__led_harness__time:datetime,
    ws1__8pa1__eolcv__led_harness__qr_code:string,
    ws1__8pa1__eolcv__led_harness__status:string,
    ws1__8pa1__eolcv__pdlc__time:datetime,
    ws1__8pa1__eolcv__lig__time:datetime,
    ws1__8pa1__eolcv__llp_primer_glass__end_time:string,
    ws1__8pa1__eolcv__llp_primer_glass__bottle1_code:string,
    ws1__8pa1__eolcv__llp_primer_glass__bottle2_code:string,
    ws1__8pa1__eolcv__llp_primer_glass__bottle3_code:string,
    ws1__8pa1__eolcv__llp_primer_glass__bottle4_code:string,
    ws1__8pa1__eolcv__llp_primer_glass__bottle5_code:string,
    ws1__8pa1__eolcv__llp_primer_pu__end_time:string,
    ws1__8pa1__eolcv__llp_primer_pu__scan_code:string,
    ws1__8pa1__eolcv__llp_primer_pu__bottle1_code:string,
    ws1__8pa1__eolcv__llp_primer_pu__bottle2_code:string,
    ws1__8pa1__eolcv__llp_primer_pu__bottle3_code:string,
    ws1__8pa1__eolcv__llp_primer_pu__bottle4_code:string,
    ws1__8pa1__eolcv__llp_primer_pu__bottle5_code:string,
    ws1__8pa1__eolcv__eol_inspection__insp_time:datetime,
    ws1__8pa1__eolcv__llp_rework__end_time:string,
    ws1__8pa1__eolcv__llp_rework__scan_code:string,
    ws1__8pa1__eolcv__llp_rework__bottle1_code:string,
    ws1__8pa1__eolcv__llp_rework__bottle2_code:string,
    ws1__8pa1__eolcv__llp_rework__bottle3_code:string,
    ws1__8pa1__eolcv__llp_rework__bottle4_code:string,
    ws1__8pa1__eolcv__llp_rework__bottle5_code:string,
    ws1__8pa1__defects_b__time:datetime,
    ws1__8pa1__defects_b__rfid:string,
    ws1__8pa1__defects_b__primer_code:string,
