// traceability_final_defect_agg_v1：Final 缺陷聚合表。
// 它把同一 dmc_code 的多条 Final 缺陷记录汇总成 Grafana/报表更容易消费的聚合字段。
.create-merge table traceability_final_defect_agg_v1 (
    dmc_code:string,
    status_agg:string,
    defect_report_time_agg:string,
    defect_code_agg:string,
    defect_surface_agg:string,
    defect_nine_grid_agg:string
)

// fn_traceability_final_defect_agg_materialize_v1：Final 缺陷聚合函数。
// 它读取 defect_plc_report_equivalent_v2，并按 dmc_code 聚合 Final 缺陷相关字段。
.create-or-alter function with (folder = "traceability/materialize", docstring = "Final defect aggregation aligned to old Grafana SQL") fn_traceability_final_defect_agg_materialize_v1() {
    defect_plc_report_equivalent_v2
    | where isnotempty(dmc_code)
    | where toupper(trim(@" ", tostring(factory))) == "FINAL"
    | extend sort_time = coalesce(defect_report_time, effective_source_time, source_time, adx_ingest_time)
    | order by dmc_code asc, sort_time asc
    | summarize
        status_list = make_list(coalesce(status, "")),
        defect_report_time_list = make_list(iff(isnull(defect_report_time), "", format_datetime(defect_report_time, "yyyy-MM-dd HH:mm:ss"))),
        defect_code_list = make_list(coalesce(defect_code, "")),
        defect_surface_list = make_list(coalesce(defect_surface, "")),
        defect_nine_grid_list = make_list(coalesce(defect_nine_grid, ""))
      by dmc_code
    | project
        dmc_code,
        status_agg = strcat_array(status_list, " | "),
        defect_report_time_agg = strcat_array(defect_report_time_list, " | "),
        defect_code_agg = strcat_array(defect_code_list, " | "),
        defect_surface_agg = strcat_array(defect_surface_list, " | "),
        defect_nine_grid_agg = strcat_array(defect_nine_grid_list, " | ")
}

// traceability_milling_defect_agg_v1：8PA1 Milling 缺陷聚合表。
// 它把同一 dmc_code 的 Milling 缺陷和工艺字段汇总成报表友好的聚合结果。
.create-merge table traceability_milling_defect_agg_v1 (
    dmc_code:string,
    status_agg:string,
    defect_code_agg:string,
    defect_report_time_agg:string,
    entry_time_agg:string,
    milling_endtime_agg:string,
    priming_code01_agg:string,
    priming_code02_agg:string,
    priming_code03_agg:string,
    process_heat_temp_agg:string
)

// fn_traceability_milling_defect_agg_materialize_v1：8PA1 Milling 缺陷聚合函数。
// 它读取 defect_plc_report_equivalent_v2，并按 dmc_code 聚合 Milling 相关缺陷与工艺字段。
.create-or-alter function with (folder = "traceability/materialize", docstring = "8PA1 Milling defect aggregation aligned to old Grafana SQL") fn_traceability_milling_defect_agg_materialize_v1() {
    defect_plc_report_equivalent_v2
    | where isnotempty(dmc_code)
    | where toupper(trim(@" ", tostring(factory))) == "8PA1_MILLING"
    | extend sort_time = coalesce(defect_report_time, effective_source_time, source_time, adx_ingest_time)
    | order by dmc_code asc, sort_time asc
    | summarize
        status_list = make_list(coalesce(status, "")),
        defect_code_list = make_list(coalesce(defect_code, "")),
        defect_report_time_list = make_list(iff(isnull(defect_report_time), "", format_datetime(defect_report_time, "yyyy-MM-dd HH:mm:ss"))),
        entry_time_list = make_list(coalesce(tostring(entry_time), "")),
        milling_endtime_list = make_list(coalesce(tostring(milling_endtime), "")),
        priming_code01_list = make_list(coalesce(priming_code01, "")),
        priming_code02_list = make_list(coalesce(priming_code02, "")),
        priming_code03_list = make_list(coalesce(priming_code03, "")),
        process_heat_temp_list = make_list(coalesce(tostring(process_heat_temp), ""))
      by dmc_code
    | project
        dmc_code,
        status_agg = strcat_array(status_list, " | "),
        defect_code_agg = strcat_array(defect_code_list, " | "),
        defect_report_time_agg = strcat_array(defect_report_time_list, " | "),
        entry_time_agg = strcat_array(entry_time_list, " | "),
        milling_endtime_agg = strcat_array(milling_endtime_list, " | "),
        priming_code01_agg = strcat_array(priming_code01_list, " | "),
        priming_code02_agg = strcat_array(priming_code02_list, " | "),
        priming_code03_agg = strcat_array(priming_code03_list, " | "),
        process_heat_temp_agg = strcat_array(process_heat_temp_list, " | ")
}

// fn_traceability_dashboard_equivalent_v1：面向 Grafana/查询页面的追溯查询封装函数。
// 它把 traceability_wide_v2、Final 聚合表、Milling 聚合表拼起来，按 printId/dmc_code 提供一站式查询结果。
.create-or-alter function with (folder = "traceability/dashboard", docstring = "Grafana-like traceability view over persisted wide snapshot and persisted defect aggregations") fn_traceability_dashboard_equivalent_v1(p_printId:string) {
    traceability_wide_v2
    | join kind = leftouter (traceability_final_defect_agg_v1) on dmc_code
    | join kind = leftouter (traceability_milling_defect_agg_v1) on dmc_code
    | where isempty(trim(@" ", p_printId)) or dmc_code == p_printId
}

// Run manually for initial load or periodic refresh. Do not place update policy on these grouped
// current-state tables, otherwise repeated ingests will append duplicate snapshots.
//
// .set-or-replace traceability_wide_v2 <| fn_traceability_wide_v2_materialize_v1()
// .set-or-replace traceability_final_defect_agg_v1 <| fn_traceability_final_defect_agg_materialize_v1()
// .set-or-replace traceability_milling_defect_agg_v1 <| fn_traceability_milling_defect_agg_materialize_v1()
