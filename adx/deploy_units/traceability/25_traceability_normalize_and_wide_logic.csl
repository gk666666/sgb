// 追溯链路等价层脚本。
//
// 作用分三块：
// 1) 定义 raw_traceability_eh 和各 topic 的 raw/std 解析函数；
// 2) 把不同追溯事件统一成长表 schema；
// 3) 基于缺陷 equivalent_v2 做业务键桥接，再拼成“一块玻璃一行”的宽表等价层。
//
// 当前正式物理落表在 45_traceability_materialized_tables.csl，
// 但物化层依赖本文件提供的 normalized event、键桥接和 wide equivalent 结果。
//
// Run in database: iotdbsekdb01prd
//
// 对象说明：
// - table raw_traceability_eh：追溯原始入湖表。
// - function fn_traceability_ws*_raw_v1()：按工位/topic 切 raw 记录。
// - function fn_traceability_schema_empty_v1()：追溯统一 schema 空表底座。
// - function fn_traceability_ws*_std_v1()：把各 topic 解析成统一追溯明细。
// - function fn_traceability_normalized_events_v1()：汇总所有追溯标准事件。
// - function fn_traceability_enrich_keys_v1(...)：按历史缺陷链补业务键。
// - function fn_traceability_wide_equivalent_v2()：把追溯事件收敛成宽表等价层。

// raw_traceability_eh：Traceability 链的原始入湖表，存放各工位追溯原始消息。
// 下游所有 fn_traceability_*_raw_v1 都从这张表按 topic 切分各工位原始数据。
.create-merge table raw_traceability_eh (
    enqueued_time: datetime,
    topic: string,
    device_name: string,
    message_id: string,
    payload: dynamic
)

// raw_traceability_eh_json：raw_traceability_eh 的 JSON ingestion mapping。
// Event Hub Data Connection 用这个 mapping 把追溯原始消息落到 raw_traceability_eh。
.create-or-alter table raw_traceability_eh ingestion json mapping "raw_traceability_eh_json"
'[
  {"column":"enqueued_time","path":"$.enqueued_time","datatype":"datetime"},
  {"column":"topic","path":"$.topic","datatype":"string"},
  {"column":"device_name","path":"$.device_name","datatype":"string"},
  {"column":"message_id","path":"$.message_id","datatype":"string"},
  {"column":"payload","path":"$.payload","datatype":"dynamic"}
]'

// fn_traceability_ws1_2cw2_raw_v1：筛出 WS1 2CW2 工位的追溯原始消息。
// 下游 fn_traceability_ws1_2cw2_std_v1 会基于它做统一字段标准化。
.create-or-alter function with (folder = "traceability/raw", docstring = "WS1 2CW2 traceability raw rows") fn_traceability_ws1_2cw2_raw_v1() {
    raw_traceability_eh
    | where topic == "SGH/MB_Traceability_Matrix/WS1/2CW2"
}

// fn_traceability_ws1_3fw2_raw_v1：筛出 WS1 3FW2 工位的追溯原始消息。
