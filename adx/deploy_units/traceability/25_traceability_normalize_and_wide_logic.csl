// 把全部追溯 topic 统一成长表标准事件层。
// 这层保留“事件视角”，适合排障、核对原始解析结果和后续物化历史事件表。
// fn_traceability_normalized_events_v1：把所有已接入工位的标准化追溯结果合并成统一事件流。
// 后续物化表 traceability_normalized_events_v2 以及宽表函数都会基于它继续处理。
.create-or-alter function with (folder = "traceability/std", docstring = "Union of normalized traceability event rows") fn_traceability_normalized_events_v1() {
    union
        fn_traceability_ws1_2cw2_std_v1(),
        fn_traceability_ws1_3fw2_std_v1(),
        fn_traceability_ws1_4aw2_std_v1(),
        fn_traceability_ws1_5fn6_final_std_v1(),
        fn_traceability_ws1_8pa1_eolcv_std_v1(),
        fn_traceability_ws1_8pa1_milling_std_v1(),
        fn_traceability_ws1_8pa1_defects_b_std_v1(),
        fn_traceability_ws1_8pa1_packing_std_v1(),
        fn_traceability_ws1_8pa1_curing_std_v1(),
        fn_traceability_ws3_prim_std_v1(),
        fn_traceability_ws3_prim_inspec_std_v1(),
        fn_traceability_ws3_pu1_std_v1(),
        fn_traceability_ws3_curing_std_v1()
}

// 追溯桥接层：
// 对只有 RFID、没有 dmc/aura/pdlc 的追溯事件，
// 从 defect_plc_report_equivalent_v2 中按 rfid_prefix28 + 更早历史时间补业务键。
// 补完后 canonical_glass_key 优先切到 dmc_code，否则仍用 rfid。
// fn_traceability_enrich_keys_v1：追溯业务键补齐桥接函数。
// 它会按 RFID 前 28 位和历史时间顺序，从缺陷等价结果里回填 dmc/aura/pdlc 等业务键。
.create-or-alter function with (folder = "traceability/bridge", docstring = "Backfill traceability business keys from historical defect equivalent records by RFID prefix 28 and earlier event time") fn_traceability_enrich_keys_v1(T:(row_id:string, event_time:datetime, dmc_code:string, rfid:string, aura_code:string, pdlc_code:string)) {
    let history =
        defect_plc_report_equivalent_v2
        | where isnotempty(rfid_prefix28)
        | extend history_time = coalesce(effective_source_time, source_time, defect_report_time, adx_ingest_time)
        | project
            rfid_prefix28,
            history_time,
            history_dmc_code = dmc_code,
            history_aura_code = aura_code,
            history_pdlc_code = pdlc_code;
    let base =
        T
        | extend base_rfid_prefix28 = iff(isnotempty(rfid), substring(rfid, 0, 28), "")
        | project
            row_id,
            event_time,
            rfid,
            base_dmc_code = dmc_code,
            base_aura_code = aura_code,
            base_pdlc_code = pdlc_code,
            base_rfid_prefix28;
    let filled =
        base
        | where isnotempty(base_rfid_prefix28) and (isempty(base_dmc_code) or isempty(base_aura_code) or isempty(base_pdlc_code))
        | join kind = leftouter (
            history
            | project
                base_rfid_prefix28 = rfid_prefix28,
                history_time,
                history_dmc_code,
                history_aura_code,
                history_pdlc_code
        ) on base_rfid_prefix28
        | where isnull(history_time) or history_time <= event_time
        | summarize arg_max(history_time, *) by row_id
        | project
            row_id,
            enriched_dmc_code = coalesce(base_dmc_code, history_dmc_code),
            enriched_aura_code = coalesce(base_aura_code, history_aura_code),
            enriched_pdlc_code = coalesce(base_pdlc_code, history_pdlc_code);
    base
    | join kind = leftouter filled on row_id
    | project
        row_id,
        event_time,
        rfid,
        dmc_code = coalesce(enriched_dmc_code, base_dmc_code),
        aura_code = coalesce(enriched_aura_code, base_aura_code),
        pdlc_code = coalesce(enriched_pdlc_code, base_pdlc_code),
        canonical_glass_key = coalesce(coalesce(enriched_dmc_code, base_dmc_code), rfid)
}

// v2 宽表等价层是追溯主链的核心：
// 1) 每个来源工位先单独解析并补业务键；
// 2) 以 canonical_glass_key 作为统一聚合键；
// 3) 对每个工位取该玻璃最新一条有效记录；
// 4) 8PA1 Packing 会按槽位拆开，8PA1 Curing 再按 rack_id 回连；
// 5) 最终拼成一块玻璃一行，尽量对齐老 glass_traceability_wide_table 语义。
// fn_traceability_wide_equivalent_v2：当前更完整的追溯宽表逻辑视图。
// 它把标准化事件进一步整理成“一片玻璃一行”的宽表语义，供后续物化和看板查询使用。
.create-or-alter function with (folder = "traceability/equivalent", docstring = "Wide-table parity layer in ADX: one glass per row with historical key bridge and rack-based 8PA1 curing association") fn_traceability_wide_equivalent_v2() {
    let ws1_2cw2_src =
        fn_traceability_ws1_2cw2_raw_v1()
        | extend p = iff(isnotnull(payload["2cw2"]), todynamic(payload["2cw2"]), payload)
        | extend
            row_id = strcat("ws1_2cw2|", message_id),
            raw_event_time = coalesce(todatetime(tostring(p.time)), todatetime(tostring(p.timestamp)), enqueued_time),
            raw_dmc_code = trim(@" ", tostring(p.dmc_code)),
            raw_rfid = trim(@" ", coalesce(tostring(p.rfid), tostring(p.rfid_code), tostring(p.glass_rfid), tostring(p.glass_rfid_code)))
        | where isnotempty(coalesce(raw_dmc_code, raw_rfid));
    let ws1_2cw2_keys =
        ws1_2cw2_src
        | project row_id, event_time = raw_event_time, dmc_code = raw_dmc_code, rfid = raw_rfid, aura_code = "", pdlc_code = ""
        | invoke fn_traceability_enrich_keys_v1();
    let ws1_2cw2 =
        ws1_2cw2_src
        | join kind = inner ws1_2cw2_keys on row_id
        | project canonical_glass_key, raw_event_time, dmc_code, rfid, aura_code, pdlc_code, ws1__2cw2__rfid = raw_rfid
        | summarize arg_max(raw_event_time, dmc_code, rfid, aura_code, pdlc_code, ws1__2cw2__rfid) by canonical_glass_key
        | project canonical_glass_key, dmc_code, rfid, aura_code, pdlc_code, ws1__2cw2__time = raw_event_time, ws1__2cw2__rfid;
    let ws1_3fw2_src =
        fn_traceability_ws1_3fw2_raw_v1()
        | extend p = iff(isnotnull(payload["3fw2"]), todynamic(payload["3fw2"]), payload)
        | extend
            row_id = strcat("ws1_3fw2|", message_id),
            raw_event_time = coalesce(todatetime(tostring(p.time)), todatetime(tostring(p.timestamp)), enqueued_time),
            raw_dmc_code = trim(@" ", tostring(p.dmc_code)),
            raw_rfid = trim(@" ", coalesce(tostring(p.rfid), tostring(p.rfid_code), tostring(p.glass_rfid), tostring(p.glass_rfid_code))),
            ws1__3fw2__mold_number = toint(p.mold_number),
            ws1__3fw2__mold_type = toint(p.mold_type),
            ws1__3fw2__mold_temp = toint(p.mold_temp),
            ws1__3fw2__furnace_ch1_temp = toint(p.furnace_ch1_temp),
            ws1__3fw2__furnace_ch3_temp = toint(p.furnace_ch3_temp),
            ws1__3fw2__furnace_ch5_temp = toint(p.furnace_ch5_temp)
        | where isnotempty(coalesce(raw_dmc_code, raw_rfid));
    let ws1_3fw2_keys =
        ws1_3fw2_src
        | project row_id, event_time = raw_event_time, dmc_code = raw_dmc_code, rfid = raw_rfid, aura_code = "", pdlc_code = ""
        | invoke fn_traceability_enrich_keys_v1();
    let ws1_3fw2 =
        ws1_3fw2_src
        | join kind = inner ws1_3fw2_keys on row_id
        | project canonical_glass_key, raw_event_time, dmc_code, rfid, aura_code, pdlc_code, ws1__3fw2__rfid = raw_rfid, ws1__3fw2__mold_number, ws1__3fw2__mold_type, ws1__3fw2__mold_temp, ws1__3fw2__furnace_ch1_temp, ws1__3fw2__furnace_ch3_temp, ws1__3fw2__furnace_ch5_temp
        | summarize arg_max(raw_event_time, dmc_code, rfid, aura_code, pdlc_code, ws1__3fw2__rfid, ws1__3fw2__mold_number, ws1__3fw2__mold_type, ws1__3fw2__mold_temp, ws1__3fw2__furnace_ch1_temp, ws1__3fw2__furnace_ch3_temp, ws1__3fw2__furnace_ch5_temp) by canonical_glass_key
        | project canonical_glass_key, dmc_code, rfid, aura_code, pdlc_code, ws1__3fw2__time = raw_event_time, ws1__3fw2__rfid, ws1__3fw2__mold_number, ws1__3fw2__mold_type, ws1__3fw2__mold_temp, ws1__3fw2__furnace_ch1_temp, ws1__3fw2__furnace_ch3_temp, ws1__3fw2__furnace_ch5_temp;
    let ws1_4aw2_src =
        fn_traceability_ws1_4aw2_raw_v1()
        | extend p = iff(isnotnull(payload["4aw2"]), todynamic(payload["4aw2"]), payload)
        | extend
            row_id = strcat("ws1_4aw2|", message_id),
            raw_event_time = coalesce(todatetime(tostring(p.time)), todatetime(tostring(p.timestamp)), enqueued_time),
            raw_dmc_code = trim(@" ", tostring(p.dmc_code)),
            raw_rfid = trim(@" ", coalesce(tostring(p.rfid), tostring(p.rfid_code), tostring(p.glass_rfid), tostring(p.glass_rfid_code)))
        | where isnotempty(coalesce(raw_dmc_code, raw_rfid));
    let ws1_4aw2_keys =
        ws1_4aw2_src
        | project row_id, event_time = raw_event_time, dmc_code = raw_dmc_code, rfid = raw_rfid, aura_code = "", pdlc_code = ""
        | invoke fn_traceability_enrich_keys_v1();
    let ws1_4aw2 =
        ws1_4aw2_src
        | join kind = inner ws1_4aw2_keys on row_id
        | project canonical_glass_key, raw_event_time, dmc_code, rfid, aura_code, pdlc_code, ws1__4aw2__rfid = raw_rfid
        | summarize arg_max(raw_event_time, dmc_code, rfid, aura_code, pdlc_code, ws1__4aw2__rfid) by canonical_glass_key
        | project canonical_glass_key, dmc_code, rfid, aura_code, pdlc_code, ws1__4aw2__time = raw_event_time, ws1__4aw2__rfid;
    let ws1_5fn6_src =
        fn_traceability_ws1_5fn6_final_raw_v1()
        | extend defects = todynamic(payload.defects)
        | mv-apply defect = defects on (summarize max_report_time = max(todatetime(tostring(defect.report_time))))
        | extend
            row_id = strcat("ws1_5fn6_final|", message_id),
            raw_event_time = coalesce(max_report_time, enqueued_time),
            raw_dmc_code = trim(@" ", tostring(payload.dmc_code)),
            raw_rfid = trim(@" ", coalesce(tostring(payload.rfid_code), tostring(payload.rfid), tostring(payload.RFID))),
            raw_aura_code = trim(@" ", tostring(payload.aura_code)),
            raw_pdlc_code = trim(@" ", tostring(payload.pdlc_code)),
            raw_mest_result = trim(@" ", tostring(payload.mest_result)),
            raw_status = toupper(trim(@" ", tostring(payload.status)))
        | where isnotempty(coalesce(raw_dmc_code, raw_rfid));
    let ws1_5fn6_keys =
        ws1_5fn6_src
        | project row_id, event_time = raw_event_time, dmc_code = raw_dmc_code, rfid = raw_rfid, aura_code = raw_aura_code, pdlc_code = raw_pdlc_code
        | invoke fn_traceability_enrich_keys_v1();
    let ws1_5fn6 =
        ws1_5fn6_src
        | join kind = inner ws1_5fn6_keys on row_id
        | project canonical_glass_key, raw_event_time, dmc_code, rfid, aura_code, pdlc_code, raw_mest_result, raw_status, ws1__5fn6__final__rfid = raw_rfid
        | summarize arg_max(raw_event_time, dmc_code, rfid, aura_code, pdlc_code, raw_mest_result, raw_status, ws1__5fn6__final__rfid) by canonical_glass_key
        | project canonical_glass_key, dmc_code, rfid, aura_code, pdlc_code, mest_result = raw_mest_result, status = raw_status, ws1__5fn6__final__time = raw_event_time, ws1__5fn6__final__rfid;
    let ws3_prim_src =
        fn_traceability_ws3_prim_raw_v1()
        | extend p = iff(isnotnull(payload.ws3_prim), todynamic(payload.ws3_prim), payload)
        | extend
            row_id = strcat("ws3_prim|", message_id),
            raw_event_time = coalesce(todatetime(tostring(p.time)), todatetime(tostring(p.timestamp)), enqueued_time),
            raw_rfid = trim(@" ", coalesce(tostring(p.rfid_write), tostring(p.rfid_read_write))),
            ws3__prim__bottle1_code = trim(@" ", tostring(p.bottle1_code)),
            ws3__prim__bottle2_code = trim(@" ", tostring(p.bottle2_code)),
            ws3__prim__bottle3_code = trim(@" ", tostring(p.bottle3_code)),
            ws3__prim__temp = todouble(p.temp),
            ws3__prim__humidity = todouble(p.humidity),
            ws3__prim__inspec_rfid_write = trim(@" ", tostring(p.inspec_rfid_write))
        | where isnotempty(raw_rfid);
    let ws3_prim_keys =
        ws3_prim_src
        | project row_id, event_time = raw_event_time, dmc_code = "", rfid = raw_rfid, aura_code = "", pdlc_code = ""
        | invoke fn_traceability_enrich_keys_v1();
    let ws3_prim =
        ws3_prim_src
