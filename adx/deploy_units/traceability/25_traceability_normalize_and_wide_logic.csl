// fn_traceability_schema_empty_v1：统一 traceability schema 的空骨架函数。
// 各工位标准化函数会按这套字段结构对齐，便于后续 union 和物化。
.create-or-alter function with (folder = "traceability/std", docstring = "Normalized traceability schema helper") fn_traceability_schema_empty_v1() {
    datatable(
        glass_key:string,
        event_time:datetime,
        event_source:string,
        source_topic:string,
        source_message_id:string,
        dmc_code:string,
        rfid:string,
        rfid_prefix28:string,
        aura_code:string,
        pdlc_code:string,
        mest_result:string,
        status:string,
        lig_code:string,
        bracket_rfid_code:string,
        primer_code:string,
        rack_id:string,
        slot_id:int,
        bottle1_code:string,
        bottle2_code:string,
        bottle3_code:string,
        temp:real,
        humidity:real
    )[]
}

// fn_traceability_ws1_2cw2_std_v1：把 WS1 2CW2 原始消息标准化成统一追溯字段。
// fn_traceability_normalized_events_v1 会把它与其他工位的标准化结果一起合并。
.create-or-alter function with (folder = "traceability/std", docstring = "WS1 2CW2 normalized traceability rows") fn_traceability_ws1_2cw2_std_v1() {
    fn_traceability_ws1_2cw2_raw_v1()
    | extend p = iff(isnotnull(payload["2cw2"]), todynamic(payload["2cw2"]), payload)
    | extend
        dmc_code = trim(@" ", tostring(p.dmc_code)),
        rfid = trim(@" ", coalesce(tostring(p.rfid), tostring(p.rfid_code), tostring(p.glass_rfid), tostring(p.glass_rfid_code))),
        glass_key = coalesce(dmc_code, rfid),
        event_time = coalesce(todatetime(tostring(p.time)), todatetime(tostring(p.timestamp)), enqueued_time)
    | where isnotempty(glass_key)
    | project
        glass_key,
        event_time,
        event_source = "ws1_2cw2",
        source_topic = topic,
        source_message_id = message_id,
        dmc_code,
        rfid,
        rfid_prefix28 = substring(rfid, 0, 28),
        aura_code = "",
        pdlc_code = "",
        mest_result = "",
        status = "",
        lig_code = "",
        bracket_rfid_code = "",
        primer_code = "",
        rack_id = "",
        slot_id = int(null),
        bottle1_code = "",
        bottle2_code = "",
        bottle3_code = "",
        temp = real(null),
        humidity = real(null)
}

