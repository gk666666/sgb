// fn_traceability_ws1_5fn6_final_std_v1：把 WS1 5FN6 Final 原始消息标准化成统一追溯字段。
.create-or-alter function with (folder = "traceability/std", docstring = "WS1 5FN6 Final normalized traceability rows") fn_traceability_ws1_5fn6_final_std_v1() {
    fn_traceability_ws1_5fn6_final_raw_v1()
    | extend defects = todynamic(payload.defects)
    | mv-apply defect = defects on (
        summarize max_report_time = max(todatetime(tostring(defect.report_time)))
    )
    | extend
        dmc_code = trim(@" ", tostring(payload.dmc_code)),
        rfid = trim(@" ", coalesce(tostring(payload.rfid_code), tostring(payload.rfid), tostring(payload.RFID))),
        glass_key = coalesce(dmc_code, rfid),
        event_time = coalesce(max_report_time, enqueued_time),
        aura_code = trim(@" ", tostring(payload.aura_code)),
        pdlc_code = trim(@" ", tostring(payload.pdlc_code)),
        mest_result = trim(@" ", tostring(payload.mest_result)),
        status = toupper(trim(@" ", tostring(payload.status)))
    | where isnotempty(glass_key)
    | project
        glass_key,
        event_time,
        event_source = "ws1_5fn6_final",
        source_topic = topic,
        source_message_id = message_id,
        dmc_code,
        rfid,
        rfid_prefix28 = substring(rfid, 0, 28),
        aura_code,
        pdlc_code,
        mest_result,
        status,
        lig_code = "",
        bracket_rfid_code = "",
        primer_code = "",
        rack_id = "",
        slot_id = int(null),
        bottle1_code = "",
        bottle2_code = "",
        bottle3_code = "",
        temp = real(null),
        humidity = real(null)
}

// fn_traceability_ws1_8pa1_eolcv_std_v1：把 WS1 8PA1 EOLCV_A 原始消息标准化成统一追溯字段。
.create-or-alter function with (folder = "traceability/std", docstring = "WS1 8PA1 EOLCV_A normalized traceability rows") fn_traceability_ws1_8pa1_eolcv_std_v1() {
    fn_traceability_ws1_8pa1_eolcv_raw_v1()
    | extend
        eol = iff(isnotnull(payload.eol_inspection), todynamic(payload.eol_inspection), dynamic({})),
        pdlc = iff(isnotnull(payload.pdlc), todynamic(payload.pdlc), dynamic({})),
        mest = iff(isnotnull(payload.mest), todynamic(payload.mest), dynamic({}))
    | extend
        dmc_code = trim(@" ", tostring(payload.dmc_code)),
        rfid = trim(@" ", coalesce(tostring(payload.rfid), tostring(payload.rfid_code), tostring(payload.glass_rfid))),
        glass_key = coalesce(dmc_code, rfid),
        event_time = coalesce(
            todatetime(tostring(payload.production_time)),
            todatetime(tostring(payload.time)),
            todatetime(tostring(payload.timestamp)),
            todatetime(tostring(eol.inspTime)),
            enqueued_time
        ),
        pdlc_code = trim(@" ", coalesce(tostring(payload.pdlc_code), tostring(payload["PDLC Code"]))),
        mest_result = trim(@" ", coalesce(tostring(mest.mest_pdlc), tostring(mest.pdlc_ok), tostring(mest.pdlc_ng), tostring(pdlc.mest_result.pdlc))),
        status = trim(@" ", coalesce(tostring(payload.result), tostring(eol.result))),
        lig_code = trim(@" ", coalesce(tostring(payload.lig_code), tostring(mest.lig_1), tostring(mest.lig_2), tostring(payload.led_harness_code))),
        aura_code = ""
    | where isnotempty(glass_key)
    | project
        glass_key,
        event_time,
        event_source = "ws1_8pa1_eolcv",
        source_topic = topic,
        source_message_id = message_id,
        dmc_code,
        rfid,
        rfid_prefix28 = substring(rfid, 0, 28),
        aura_code,
        pdlc_code,
        mest_result,
        status,
        lig_code,
        bracket_rfid_code = "",
        primer_code = "",
        rack_id = "",
        slot_id = int(null),
        bottle1_code = "",
        bottle2_code = "",
        bottle3_code = "",
        temp = real(null),
        humidity = real(null)
}

