// Run in database: iotdbsekdb01prd
//
// 对象说明：
// - table dim_hex_nibble_map：十六进制转 bit 串的基础码表，供缺陷位展开使用。
// - table dim_defectlist_5fn6：5FN6 缺陷位到缺陷编码/名称的映射表。

// dim_hex_nibble_map：把单个十六进制字符展开成 4 位 bit 串的基础码表。
// fn_defect_final_std_from_raw_v1 和 8PA1 对应标准化函数会用它把 nine-grid 十六进制缺陷位展开。
.create-merge table dim_hex_nibble_map (
    nibble: string,
    bits: string
)

// 初始化 dim_hex_nibble_map：把完整 16 个十六进制字符和对应 bit 串一次性写入码表。
.set-or-replace dim_hex_nibble_map <|
datatable(nibble:string, bits:string)
[
    "0","0000",
    "1","0001",
    "2","0010",
    "3","0011",
    "4","0100",
    "5","0101",
    "6","0110",
    "7","0111",
    "8","1000",
    "9","1001",
    "A","1010",
    "B","1011",
    "C","1100",
    "D","1101",
    "E","1110",
    "F","1111"
]

// dim_defectlist_5fn6：5FN6 bit 位到缺陷编码的对照表。
// fn_defect_final_std_from_raw_v1 在展开 64 位缺陷位后，会通过这张表映射出 defect_code。
.create-merge table dim_defectlist_5fn6 (
    bit_pos: int,
    defect_code: string
)

// 初始化 dim_defectlist_5fn6：把 5FN6 缺陷位与 defect_code 的正式映射一次性写入码表。
.set-or-replace dim_defectlist_5fn6 <|
datatable(bit_pos:int, defect_code:string)
[
    1, "3011",
    2, "3408",
    3, "3207",
    4, "3206",
    5, "3098",
    6, "3035",
    7, "3409",
