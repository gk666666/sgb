// fn_defect_forward_candidates_v2：全域缺陷发送候选的逻辑视图。
// 它主要用于验证全域 family 候选集合，正式上线发送仍以 scheme_b_v2 物化链为主。
.create-or-alter function with (folder = "defect/forward", docstring = "Forward candidate view v2 for full-domain validation. Keeps all eligible rows ordered by effective event time.") fn_defect_forward_candidates_v2() {
    fn_plc_defect_report_equivalent_v2()
    | order by coalesce(effective_source_time, source_time, defect_report_time, adx_ingest_time) asc, plc_id asc
}
