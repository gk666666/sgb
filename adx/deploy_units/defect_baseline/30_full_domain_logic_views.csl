// 把全部已接入缺陷 family 合并成一张统一长表。
// 后续不管是旧版函数视图，还是 v2 物化表，都会基于这个 union 结果继续处理。
// fn_defect_std_union_v1：把所有已接入的缺陷 family 标准化结果合并成一套统一 schema。
// fn_defect_std_all_v2_materialize_v1 和主数据函数 fn_glass_master_message_base 都直接依赖它。
.create-or-alter function with (folder = "defect/std", docstring = "Union of all defect families into a unified schema") fn_defect_std_union_v1() {
    union
        fn_defect_final_std_v1(),
        fn_defect_8pa1_eol_std_v1(),
        fn_defect_8pa1_milling_std_v1(),
        fn_defect_ws3_prim_std_v1(),
        fn_defect_ws3_prim_inspec_std_v1(),
        fn_defect_ws3_pu1_std_v1()
}

// 增量版 union，把时间过滤尽量前推到 raw 层，主要用于降低全量重算时的内存压力。
// fn_defect_std_union_incremental_v2：全域缺陷标准化结果的增量 union 视图。
// 用于在较小时间窗里验证统一结果，减少全表扫描。
.create-or-alter function with (folder = "defect/std", docstring = "Union of all defect families into a unified schema since start_time, with raw filtering pushed down to the raw layer") fn_defect_std_union_incremental_v2(start_time:datetime) {
    union
        fn_defect_final_std_since_v1(start_time),
        fn_defect_8pa1_eol_std_since_v1(start_time),
        fn_defect_8pa1_milling_std_since_v1(start_time),
        fn_defect_ws3_prim_std_since_v1(start_time),
        fn_defect_ws3_prim_inspec_std_since_v1(start_time),
        fn_defect_ws3_pu1_std_since_v1(start_time)
}

// v2 回填层对齐老 Python 缺陷语义：
// 1) 只对 8PA1 / WS3 等需要补业务键的记录生效；
// 2) 按 rfid_prefix28 关联历史；
// 3) 只允许更早历史补当前；
// 4) dmc / aura / pdlc 分字段独立回填；
// 5) 只补空值，不覆盖当前已有字段。
// fn_defect_business_key_backfill_v2：缺陷业务键回填 v2。
// 它按 RFID 前 28 位和历史时间顺序补 dmc/aura/pdlc，是正式 equivalent_v2 逻辑的重要基础。
.create-or-alter function with (folder = "defect/business", docstring = "Business-key backfill v2 aligned with the legacy Python defect path: backfill only from prior defect history by RFID prefix28 and point-in-time ordering") fn_defect_business_key_backfill_v2() {
    let base =
        fn_defect_std_union_v1()
        | extend candidate_event_time = coalesce(effective_source_time, source_time, defect_report_time, adx_ingest_time);
    let needs_backfill =
        base
        | where (factory startswith "8PA1" or factory startswith "WS3")
        | where isnotempty(rfid_prefix28)
        | where isempty(dmc_code) or isempty(aura_code) or isempty(pdlc_code);
    let dmc_history_hits =
        needs_backfill
        | project plc_id, rfid_prefix28, candidate_event_time
        | join kind = leftouter (
            fn_defect_std_union_v1()
            | extend history_event_time = coalesce(effective_source_time, source_time, defect_report_time, adx_ingest_time)
            | where isnotempty(rfid_prefix28)
            | where isnotempty(dmc_code)
            | project
                history_plc_id = plc_id,
                history_rfid_prefix28 = rfid_prefix28,
                history_event_time,
                history_dmc_code = dmc_code
        ) on $left.rfid_prefix28 == $right.history_rfid_prefix28
        | where isnull(history_event_time) or (history_event_time <= candidate_event_time and history_plc_id != plc_id)
        | summarize arg_max(history_event_time, *) by plc_id
        | project plc_id, dmc_history_event_time = history_event_time, history_dmc_code;
    let aura_history_hits =
        needs_backfill
        | project plc_id, rfid_prefix28, candidate_event_time
        | join kind = leftouter (
            fn_defect_std_union_v1()
            | extend history_event_time = coalesce(effective_source_time, source_time, defect_report_time, adx_ingest_time)
            | where isnotempty(rfid_prefix28)
            | where isnotempty(aura_code)
            | project
                history_plc_id = plc_id,
                history_rfid_prefix28 = rfid_prefix28,
                history_event_time,
                history_aura_code = aura_code
        ) on $left.rfid_prefix28 == $right.history_rfid_prefix28
        | where isnull(history_event_time) or (history_event_time <= candidate_event_time and history_plc_id != plc_id)
        | summarize arg_max(history_event_time, *) by plc_id
        | project plc_id, aura_history_event_time = history_event_time, history_aura_code;
    let pdlc_history_hits =
        needs_backfill
        | project plc_id, rfid_prefix28, candidate_event_time
        | join kind = leftouter (
            fn_defect_std_union_v1()
            | extend history_event_time = coalesce(effective_source_time, source_time, defect_report_time, adx_ingest_time)
            | where isnotempty(rfid_prefix28)
            | where isnotempty(pdlc_code)
            | project
                history_plc_id = plc_id,
                history_rfid_prefix28 = rfid_prefix28,
                history_event_time,
                history_pdlc_code = pdlc_code
        ) on $left.rfid_prefix28 == $right.history_rfid_prefix28
        | where isnull(history_event_time) or (history_event_time <= candidate_event_time and history_plc_id != plc_id)
        | summarize arg_max(history_event_time, *) by plc_id
        | project plc_id, pdlc_history_event_time = history_event_time, history_pdlc_code;
    base
    | join kind = leftouter dmc_history_hits on plc_id
    | join kind = leftouter aura_history_hits on plc_id
    | join kind = leftouter pdlc_history_hits on plc_id
    | extend
        dmc_code = coalesce(dmc_code, history_dmc_code),
        aura_code = coalesce(aura_code, history_aura_code),
        pdlc_code = coalesce(pdlc_code, history_pdlc_code)
    | project-away
        candidate_event_time,
        dmc_history_event_time,
        aura_history_event_time,
        pdlc_history_event_time,
        history_dmc_code,
        history_aura_code,
        history_pdlc_code
}

// 这是基于函数视图的 equivalent v2 结果。
// 当前正式发送主链已经改为走 40 脚本里的物理表 equivalent_v2，
// 这里更多保留给语义验证、对照查询和历史过渡使用。
// fn_plc_defect_report_equivalent_v2：当前正式缺陷等价视图的逻辑层。
// defect_plc_report_equivalent_v2 这张正式结果表，本质上就是把这套逻辑再物化落表。
.create-or-alter function with (folder = "defect/equivalent", docstring = "Equivalent view v2 that keeps full-domain family parsing and RFID28 business-key backfill semantics") fn_plc_defect_report_equivalent_v2() {
    fn_defect_business_key_backfill_v2()
    | project
        plc_id,
        factory,
        dmc_code,
        rfid,
        aura_code,
        pdlc_code,
        lig_code,
        bracket_rfid_code,
        primer_code,
        glass_id,
        model_id,
        mest_result,
        status,
        defect_report_time,
        defect_report_time_source,
        defect_report_post,
        defect_code,
        defect_name,
        defect_nine_grid,
        defect_surface,
        record_role,
        has_defect,
        payload_family,
        source_time,
        effective_source_time,
        adx_ingest_time,
        source_topic,
        source_message_id,
        rfid_prefix28,
        ws3_timestamp,
        ws3_bottle1_code,
        ws3_bottle2_code,
        ws3_bottle3_code,
        ws3_temp,
        ws3_humidity,
        ws3_inspec_rfid_write,
        ws3_mold_up_zone01,
        ws3_mold_up_zone02,
        ws3_mold_down_zone01,
        ws3_mold_down_zone02,
        entry_time,
        milling_endtime,
        process_st_milling,
        process_st_heat,
        process_st_priming,
        process_heat_temp,
        priming_code01,
        priming_code02,
        priming_code03,
        priming_code04
}

// 这是回填 v2 的增量版，只对最近窗口候选做补键，并尽量缩小历史扫描范围。
// 主要用途是减少 portal 全量试算时的内存占用。
// fn_defect_business_key_backfill_incremental_v2：业务键回填的增量版本。
// 它只针对近窗候选缩小历史范围，主要用于降低验证和增量查询的内存压力。
.create-or-alter function with (folder = "defect/business", docstring = "Incremental business-key backfill v2 for recent forward candidates only. Narrows history to relevant RFID prefix28 values to reduce query memory.") fn_defect_business_key_backfill_incremental_v2(start_time:datetime) {
    let base =
        fn_defect_std_union_incremental_v2(start_time)
        | extend candidate_event_time = coalesce(effective_source_time, source_time, defect_report_time, adx_ingest_time);
    let candidate_base =
        materialize(
            base
            | where candidate_event_time > start_time
        );
    let needs_backfill =
        materialize(
            candidate_base
            | where (factory startswith "8PA1" or factory startswith "WS3")
            | where isnotempty(rfid_prefix28)
            | where isempty(dmc_code) or isempty(aura_code) or isempty(pdlc_code)
        );
    let relevant_prefixes =
        materialize(
            needs_backfill
            | summarize by rfid_prefix28
        );
    let history_base =
        base
        | where isnotempty(rfid_prefix28)
        | join kind = inner hint.strategy=broadcast relevant_prefixes on rfid_prefix28
        | project
            history_plc_id = plc_id,
            rfid_prefix28,
            history_event_time = candidate_event_time,
            history_dmc_code = dmc_code,
            history_aura_code = aura_code,
            history_pdlc_code = pdlc_code;
    let dmc_history_hits =
        needs_backfill
        | project plc_id, rfid_prefix28, candidate_event_time
        | join kind = leftouter (
            history_base
            | where isnotempty(history_dmc_code)
            | project history_plc_id, rfid_prefix28, history_event_time, history_dmc_code
        ) on rfid_prefix28
        | where isnull(history_event_time) or (history_event_time <= candidate_event_time and history_plc_id != plc_id)
        | summarize arg_max(history_event_time, history_dmc_code) by plc_id
        | project plc_id, dmc_history_event_time = history_event_time, history_dmc_code;
    let aura_history_hits =
        needs_backfill
        | project plc_id, rfid_prefix28, candidate_event_time
        | join kind = leftouter (
            history_base
            | where isnotempty(history_aura_code)
            | project history_plc_id, rfid_prefix28, history_event_time, history_aura_code
        ) on rfid_prefix28
        | where isnull(history_event_time) or (history_event_time <= candidate_event_time and history_plc_id != plc_id)
        | summarize arg_max(history_event_time, history_aura_code) by plc_id
        | project plc_id, aura_history_event_time = history_event_time, history_aura_code;
    let pdlc_history_hits =
        needs_backfill
        | project plc_id, rfid_prefix28, candidate_event_time
        | join kind = leftouter (
            history_base
            | where isnotempty(history_pdlc_code)
            | project history_plc_id, rfid_prefix28, history_event_time, history_pdlc_code
        ) on rfid_prefix28
        | where isnull(history_event_time) or (history_event_time <= candidate_event_time and history_plc_id != plc_id)
        | summarize arg_max(history_event_time, history_pdlc_code) by plc_id
        | project plc_id, pdlc_history_event_time = history_event_time, history_pdlc_code;
    candidate_base
    | join kind = leftouter dmc_history_hits on plc_id
    | join kind = leftouter aura_history_hits on plc_id
    | join kind = leftouter pdlc_history_hits on plc_id
    | extend
        dmc_code = coalesce(dmc_code, history_dmc_code),
        aura_code = coalesce(aura_code, history_aura_code),
        pdlc_code = coalesce(pdlc_code, history_pdlc_code)
    | project-away
        candidate_event_time,
        dmc_history_event_time,
        aura_history_event_time,
        pdlc_history_event_time,
        history_dmc_code,
        history_aura_code,
        history_pdlc_code
}

// fn_plc_defect_report_equivalent_incremental_v2：正式等价视图的增量版本。
// 它结合增量业务键回填函数，只计算最近时间窗内的等价输出。
.create-or-alter function with (folder = "defect/equivalent", docstring = "Incremental equivalent view v2 for recent forward candidates. Uses narrowed RFID28 backfill scope to reduce memory usage.") fn_plc_defect_report_equivalent_incremental_v2(start_time:datetime) {
    fn_defect_business_key_backfill_incremental_v2(start_time)
    | project
        plc_id,
