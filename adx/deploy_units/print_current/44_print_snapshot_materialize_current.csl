// Print / 丝网 当前线上链路补充脚本。
//
// 说明：
// 1) raw_print_eh 及其 json mapping 保持不变；
// 2) 当前按客户最新统一后的小写字段直接解析；
// 3) 由于 2CW2 样例中的 OFF_CONTACT_RATIO 已出现小数，std 表中的
//    off_contact_ratio 需使用 real，旧表如果还是 int，请按 runbook 重建；
//
// 对象说明：
// - table raw_print_eh：Print / 丝网原始入湖表。
// - table print_snapshot_std：Print / 丝网标准快照表。
// - function fn_print_snapshot_materialize()：把 raw_print_eh 中指定 topic 解析成标准快照。
// - policy print_snapshot_std update policy：让 raw 新数据自动进入标准快照表。

// raw_print_eh：Print/丝网链的原始入湖表，只保存 Event Hub 原始消息。
// fn_print_snapshot_materialize() 会直接从这张表读取指定 topic 并标准化。
.create-merge table raw_print_eh (
    enqueued_time: datetime,
    emqx_ts: long,
    topic: string,
    device_name: string,
    message_id: string,
    payload: dynamic
)

// raw_print_eh_json：raw_print_eh 的 JSON ingestion mapping。
// Event Hub Data Connection 用这个 mapping 把 print 原始消息落到 raw_print_eh。
.create-or-alter table raw_print_eh ingestion json mapping "raw_print_eh_json" '[{"column":"enqueued_time","path":"$.enqueued_time","datatype":"datetime"},{"column":"emqx_ts","path":"$.emqx_ts","datatype":"long"},{"column":"topic","path":"$.topic","datatype":"string"},{"column":"device_name","path":"$.device_name","datatype":"string"},{"column":"message_id","path":"$.message_id","datatype":"string"},{"column":"payload","path":"$.payload","datatype":"dynamic"}]'

// print_snapshot_std：Print/丝网标准快照表。
// 下游查询、联调或接口组包都应优先看这张标准表，而不是直接扫 raw_print_eh。
.create-merge table print_snapshot_std (
    read_time: datetime,
    topic: string,
    workcenter: string,
    equipment: string,
    status: int,
    dmc_code: string,
    rfid_code: string,
    print_cnt: long,
    print_spd: int,
    print_stroke: int,
    ink_ret_spd: int,
    ink_ret_stroke: int,
    off_contact_hgt: int,
    off_contact_ratio: real,
    silk_screen_life: long,
    silk_screen_status: string,
    ir1_maxtemp: real,
    ir1_mintemp: real,
    ir1_curtemp: real,
    ir2_maxtemp: real,
    ir2_mintemp: real,
    ir2_curtemp: real,
    dry1_speed: real
)

// fn_print_snapshot_materialize：把 raw_print_eh 中指定 topic 的原始报文解析成 print_snapshot_std 的标准字段。
// print_snapshot_std 的 update policy 会直接调用它。
.create-or-alter function with (folder = "print/std", docstring = "PRINT/SILK SCREEN standardized rows from raw_print_eh") fn_print_snapshot_materialize() {
    raw_print_eh
    | where topic in (
        "SGH/WS1/NMF180/2CW6/PRINT1",
        "SGH/WS1/NMF180/2CW6/PRINT2",
        "SGH/WS1/NMF180/2CW6/PRINT3",
        "SGH/WS1/MF180/2CW2/PRINT3"
    )
    | extend p = todynamic(payload)
    | project
        read_time = todatetime(tostring(p.read_time)),
        topic,
        workcenter = tostring(p.workcenter),
        equipment = tostring(p.equipment),
        status = toint(p.status),
        dmc_code = tostring(p.dmc_code),
        rfid_code = tostring(p.rfid_code),
        print_cnt = tolong(p.print_cnt),
        print_spd = toint(p.print_spd),
        print_stroke = toint(p.print_stroke),
        ink_ret_spd = toint(p.ink_ret_spd),
        ink_ret_stroke = toint(p.ink_ret_stroke),
        off_contact_hgt = toint(p.off_contact_hgt),
        off_contact_ratio = todouble(p.off_contact_ratio),
        silk_screen_life = tolong(p.silk_screen_life),
        silk_screen_status = tostring(p.silk_screen_status),
        ir1_maxtemp = todouble(p.ir1_maxtemp),
        ir1_mintemp = todouble(p.ir1_mintemp),
        ir1_curtemp = todouble(p.ir1_curtemp),
        ir2_maxtemp = todouble(p.ir2_maxtemp),
        ir2_mintemp = todouble(p.ir2_mintemp),
        ir2_curtemp = todouble(p.ir2_curtemp),
        dry1_speed = todouble(p.dry1_speed)
}

// print_snapshot_std update policy：把 raw_print_eh 的新消息自动清洗后写入 print_snapshot_std。
// 也就是 raw_print_eh 是源表，fn_print_snapshot_materialize() 是清洗逻辑，print_snapshot_std 是结果表。
.alter table print_snapshot_std policy update @'[{"IsEnabled":true,"Source":"raw_print_eh","Query":"fn_print_snapshot_materialize()","IsTransactional":false,"PropagateIngestionProperties":true}]'
